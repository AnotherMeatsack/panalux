{
  "_comment": [
    "PanaLux factory map. Panel control -> MIDI2LR command id.",
    "Lightroom keeps the legacy 'SplitToning*' names for shadow and highlight hue/saturation;",
    "midtones use 'ColorGrade*'. That asymmetry is Adobe's.",
    "Encoder deltas arrive in ticks of 360. A brisk knob turn is roughly 470 ticks, so a",
    "scale of 0.0003 moves a parameter about 14% of its range per turn. 'radius' is how",
    "much ball travel reaches full saturation."
  ],
  "knobs": {
    "Y_LIFT": {
      "param": "Blacks",
      "scale": 0.0003
    },
    "Y_GAMMA": {
      "param": "Exposure",
      "scale": 0.0003
    },
    "Y_GAIN": {
      "param": "Whites",
      "scale": 0.0003
    },
    "CONTRAST": {
      "param": "Contrast",
      "scale": 0.0003
    },
    "PIVOT": {
      "param": "Clarity",
      "scale": 0.0003
    },
    "MID_DETAIL": {
      "param": "Texture",
      "scale": 0.0003
    },
    "COL_BOOST": {
      "param": "Vibrance",
      "scale": 0.0003
    },
    "SHAD": {
      "param": "Shadows",
      "scale": 0.0003
    },
    "HI_LIGHT": {
      "param": "Highlights",
      "scale": 0.0003
    },
    "SAT": {
      "param": "Saturation",
      "scale": 0.0003
    },
    "HUE": {
      "param": "Temperature",
      "scale": 0.0003
    },
    "LUM_MIX": {
      "param": "ColorGradeBlending",
      "scale": 0.0003
    }
  },
  "rings": {
    "RING_LIFT": {
      "param": "ColorGradeShadowLum",
      "scale": 0.0003
    },
    "RING_GAMMA": {
      "param": "ColorGradeMidtoneLum",
      "scale": 0.0003
    },
    "RING_GAIN": {
      "param": "ColorGradeHighlightLum",
      "scale": 0.0003
    }
  },
  "balls": {
    "TB_LIFT": {
      "hue": "SplitToningShadowHue",
      "sat": "SplitToningShadowSaturation",
      "radius": 3000.0,
      "invert_x": true,
      "invert_y": true
    },
    "TB_GAMMA": {
      "hue": "ColorGradeMidtoneHue",
      "sat": "ColorGradeMidtoneSat",
      "radius": 3000.0,
      "invert_x": true,
      "invert_y": true
    },
    "TB_GAIN": {
      "hue": "SplitToningHighlightHue",
      "sat": "SplitToningHighlightSaturation",
      "radius": 3000.0,
      "invert_x": true,
      "invert_y": true
    }
  },
